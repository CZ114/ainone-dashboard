# AinOne Dashboard - Environment Variables Template
# Copy this file to .env in the project root and fill in real values.
# NEVER commit .env to version control.

# =============================================================================
# Python Backend (FastAPI) — port 8080
# =============================================================================
# No required env vars for the core sensor backend.
# All configuration is hard-coded in backend/app/config.py.
#
# Optional: override the default serial baud rate.
# SERIAL_BAUD_RATE=115200

# Optional: override the default BLE device name filter.
# BLE_DEVICE_NAME=ESP32-S3-MultiSensor

# Optional: override the UDP audio listening port.
# AUDIO_PORT=8888

# =============================================================================
# Claude Backend (Hono/Node.js) — port 3000
# =============================================================================
# PORT=3000
# HOST=127.0.0.1
#
# Path to the Claude CLI executable.
# If not set, the backend will attempt to auto-detect it.
# CLAUDE_PATH=
#
# Enable debug mode logging (true/false).
# DEBUG=false

# =============================================================================
# Frontend (Vite) — port 5173
# =============================================================================
# VITE_API_BASE_URL=http://localhost:8080
# (Not required — Vite proxy handles all routing during development.)
