# ADvoice report-chat service from doctor_three_condition_demo.
# The fused platform already uses :8080 for its sensor FastAPI backend,
# so run the report-chat server on another port during local development:
#   $env:ADVOICE_PORT='8081'; python server.py
# Copy this file to .env.local before starting/restarting Vite.
VITE_DOCTOR_CHAT_API_BASE=http://127.0.0.1:8081